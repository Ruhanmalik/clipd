# .env.example  — copy to .env and fill in. NEVER commit .env.
# Generate with: openssl rand -base64 32
INGEST_TOKEN=replace-me

# One ntfy topic per service (plan.md §4). Use something unguessable —
# ntfy.sh topics are public to anyone who knows the name.
NTFY_TOPIC=clipd-replace-me

# Size cap only, no age limit (spec §7). Must be > 0.
MAX_STORE_BYTES=50GB

# Largest single upload accepted. Rejected with 413 before the body is spooled.
MAX_UPLOAD_BYTES=2GB

# Used to build the URLs returned by /ingest and pushed to ntfy.
BASE_URL=http://clipd-server.tailnet-name.ts.net:8000

# --- optional, shown with their defaults ---
# NTFY_SERVER=https://ntfy.sh
# SWEEP_INTERVAL_S=900
# SHARE_ENABLED=false     # plan.md §7: routes exist, flag stays off for now
# LOG_LEVEL=INFO
